[Unit]
Description=Sincro - subtitulos en vivo (FastAPI/Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sincro
EnvironmentFile=/opt/sincro/.env
ExecStart=/opt/sincro/.venv/bin/uvicorn captions.main:app --app-dir src --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
User=sincro
Group=sincro

[Install]
WantedBy=multi-user.target
