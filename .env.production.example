# Copiar a .env en el servidor de producción.
CAPTIONS_ENGINE=gemini_live
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

CAPTIONS_MODEL=gemini-live-2.5-flash-preview
CAPTIONS_REST_MODEL=gemini-2.5-flash

# Config de sesiones a usar
CAPTIONS_CONFIG=sessions.yaml

# Bind (nginx hace de reverse proxy en 443)
HOST=127.0.0.1
PORT=8000
