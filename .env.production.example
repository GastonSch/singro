# Copiar a .env en el servidor de producción.
CAPTIONS_ENGINE=gemini_live
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Motor Live de traducción nativa (modelo + translation_config)
CAPTIONS_MODEL=gemini-3.5-live-translate-preview
CAPTIONS_REST_MODEL=gemini-3.8-flash
CAPTIONS_NATIVE_TRANSLATION=1

# Config de sesiones a usar
CAPTIONS_CONFIG=sessions.yaml

# Bind: 0.0.0.0 si nginx/Proxy Manager corre en otro contenedor/host
HOST=0.0.0.0
PORT=8000
