# Copiar a .env y completar.
# Motor: gemini_live | gemini_chunk | local | mock
# Dejalo en "mock" para probar sin credenciales; cambialo a "gemini_live" con API key.
CAPTIONS_ENGINE=mock

# Requerido para los motores Gemini (gemini_live / gemini_chunk).
GEMINI_API_KEY=

# Modelo del modo Live (traduccion nativa en streaming).
CAPTIONS_MODEL=gemini-3.5-live-translate-preview

# Modelo del modo REST por bloques (fallback robusto).
CAPTIONS_REST_MODEL=gemini-3.8-flash

# Ruta al archivo de sesiones (por defecto ./sessions.yaml).
# CAPTIONS_CONFIG=sessions.yaml

# Traduccion nativa del modelo Live
CAPTIONS_NATIVE_TRANSLATION=1
